---
import { formatBlogDate } from '../../utils/blog'
import Media from '../home-v3/Media.astro'
const { post, eager = false } = Astro.props
const { data, id } = post
const headingId = `blog-title-${id}`
---
<article class="bv3-feature" aria-labelledby={headingId}>
  {data.image && <figure class="hv3-media-frame bv3-feature-media" style={`--bv3-image-ratio: ${data.imageWidth} / ${data.imageHeight}`}><Media src={data.image} alt={data.imageAlt || data.title} width={data.imageWidth} height={data.imageHeight} eager={eager} /></figure>}
  <div class="bv3-feature-copy">
    <div class="bv3-meta">{data.category && <span>{data.category}</span>}{data.publishedAt && <time datetime={data.publishedAt.toISOString()}>{formatBlogDate(data.publishedAt)}</time>}</div>
    <h2 id={headingId}>{data.title}</h2>
    <p>{data.description}</p>
    <a class="hv3-text-link" href={`/blog/${id}/`} aria-label={`Đọc bài viết: ${data.title}`}>Đọc bài viết <span aria-hidden="true">↗</span></a>
  </div>
</article>

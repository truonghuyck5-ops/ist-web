---
import { formatBlogDate } from '../../utils/blog'

const { post } = Astro.props
const { data, id } = post
---

<article class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-950/50 transition hover:border-orange-500">
  {data.image && <img src={data.image} alt={data.title} loading="lazy" decoding="async" class="h-64 w-full object-cover transition duration-500 group-hover:scale-[1.02]" />}
  <div class="p-7 md:p-8">
    <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
      {data.category && <span class="font-semibold text-orange-500">{data.category}</span>}
      <time datetime={data.publishedAt.toISOString()} class="text-gray-500">{formatBlogDate(data.publishedAt)}</time>
    </div>
    <h2 class="mb-4 text-2xl font-black text-white transition group-hover:text-orange-500 md:text-3xl"><a href={`/blog/${id}/`}>{data.title}</a></h2>
    <p class="mb-6 leading-relaxed text-gray-400">{data.description}</p>
    <a href={`/blog/${id}/`} class="font-bold text-orange-500 transition hover:text-orange-300">Đọc bài viết <span aria-hidden="true">→</span></a>
  </div>
</article>

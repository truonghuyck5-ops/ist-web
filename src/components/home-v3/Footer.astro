---
import { siteConfig } from '../../data/site.js'
const { contact } = siteConfig
const { home = true } = Astro.props
const homeAnchor = (id) => `${home ? '' : '/'}#${id}`
---
<footer class="hv3-footer">
  <div class="hv3-container">
    <div class="hv3-footer-grid"><div class="hv3-footer-brand"><a class="hv3-brand" href={homeAnchor('top')} aria-label={home ? 'IST — về đầu trang' : 'IST — về trang chủ'}><span>IST<span class="hv3-brand-dot" aria-hidden="true">.</span></span></a><p>{siteConfig.legalName}</p></div><div><h2>SẢN PHẨM</h2><a href="/bang-hieu/">Bảng hiệu</a><a href="#contact">In ấn</a><a href="/tem-nhan/">Tem nhãn</a><a href="/in-kho-lon/">In khổ lớn</a></div><div><h2>GIẢI PHÁP</h2><a href="/giai-phap/" data-track-event="service_cta_click" data-track-location="footer_solution" data-track-action="view_service">Giải pháp</a><a href="/combo-mo-quan/" data-track-event="service_cta_click" data-track-location="footer_solution" data-track-service="combo_mo_quan" data-track-action="view_service">Combo mở quán</a><a href="/hoa-don/">Biểu mẫu kinh doanh</a></div><div><h2>IST</h2><a href={homeAnchor('production')}>Xưởng sản xuất</a><a href="/du-an/">Công trình</a><a href="/blog/">Kiến thức</a></div><div class="hv3-footer-contact"><h2>LIÊN HỆ</h2><a href={`tel:${contact.phone}`} data-track-event="phone_click" data-track-location="footer_contact">{contact.phoneDisplay}</a><a href={`mailto:${contact.email}`} data-track-event="service_cta_click" data-track-location="footer_contact" data-track-action="quote_request">{contact.email}</a><p>{contact.address}</p></div></div>
    <div class="hv3-footer-bottom"><span>© {new Date().getFullYear()} In Sáng Tạo IST</span><span>Thiết kế · In ấn · Quảng cáo</span></div>
  </div>
</footer>

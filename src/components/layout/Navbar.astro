---
import { productMenu } from '../../data/productMenu'
---

<header class="sticky top-0 z-50 border-b border-gray-800 bg-black/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-4">
      <img src="/images/logo-ist.png" alt="IST Logo" class="h-14 w-14 object-contain" />

      <div>
        <p class="text-2xl font-bold text-orange-500">IN SÁNG TẠO</p>
        <p class="text-sm text-gray-400">Thiết kế - In ấn - Quảng cáo</p>
      </div>
    </a>

    <nav class="hidden gap-8 text-sm md:flex" aria-label="Điều hướng chính">
      <a href="/" class="transition hover:text-orange-500">Trang chủ</a>
      <span class="cursor-not-allowed text-gray-600" aria-disabled="true">Năng lực</span>

      <div class="group relative">
        <button type="button" class="flex cursor-default items-center gap-1" aria-disabled="true">
          Sản phẩm
          <span class="text-xs">▾</span>
        </button>

        <div class="invisible absolute left-0 top-full z-50 translate-y-2 pt-4 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
          <div class="w-80 overflow-hidden rounded-2xl border border-zinc-800 bg-black shadow-2xl">
            {productMenu.map((item) => (
              <div class="block px-5 py-4 text-gray-500">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <span class="block text-sm font-semibold text-white">{item.label}</span>
                    <span class="mt-1 block text-xs leading-relaxed text-gray-500">{item.description}</span>
                  </div>

                  {item.status === 'coming' && (
                    <span class="shrink-0 rounded-full border border-zinc-700 px-2 py-1 text-[10px] text-gray-500">
                      Sắp có
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <span class="cursor-not-allowed text-gray-600" aria-disabled="true">Công trình</span>
      <span class="cursor-not-allowed text-gray-600" aria-disabled="true">Blog</span>
      <a href="#contact" class="transition hover:text-orange-500">Liên hệ</a>
    </nav>

    <div class="flex items-center gap-4">
      <a href="#contact" class="hidden rounded-lg bg-orange-500 px-5 py-2 font-medium transition hover:bg-orange-600 md:block">
        Nhận tư vấn &amp; báo giá
      </a>

      <button
        type="button"
        class="text-3xl md:hidden"
        data-mobile-menu-toggle
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Mở menu điều hướng"
      >☰</button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-gray-800 md:hidden" aria-label="Điều hướng di động">
    <div class="flex flex-col gap-5 px-6 py-6 text-lg">
      <a href="/" class="transition hover:text-orange-500">Trang chủ</a>
      <span class="text-gray-600" aria-disabled="true">Năng lực</span>

      <div class="border-b border-zinc-800 py-3">
        <p class="mb-3 font-semibold text-white">Sản phẩm</p>
        <div class="grid gap-2 pl-4">
          {productMenu.map((item) => (
            <div class="py-2 text-gray-500">
              <span class="block">
                {item.label}
                {item.status === 'coming' && <span class="ml-2 text-xs text-gray-600">(sắp có)</span>}
              </span>
              <span class="mt-1 block text-xs text-gray-600">{item.description}</span>
            </div>
          ))}
        </div>
      </div>

      <span class="text-gray-600" aria-disabled="true">Công trình</span>
      <span class="text-gray-600" aria-disabled="true">Blog</span>
      <a href="#contact" class="transition hover:text-orange-500">Liên hệ</a>
      <a href="#contact" class="mt-2 rounded-xl bg-orange-500 px-5 py-3 text-center font-medium transition hover:bg-orange-600">
        Nhận tư vấn &amp; báo giá
      </a>
    </div>
  </nav>
</header>

<script>
  import '../../scripts/mobile-menu.js'
</script>

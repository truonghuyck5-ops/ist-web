---
import Media from './Media.astro'
import { featuredProjects } from '../../data/featuredProjects.js'
const projects = featuredProjects.filter((project) => project.homepageFeatured).slice(0, 4)
---
<section id="projects" class="pv3-section pv3-projects-section" aria-labelledby="projects-heading">
  <div class="pv3-container">
    <div class="pv3-section-head"><div><p class="pv3-eyebrow">03 / DẤU ẤN THỰC TẾ</p><h2 id="projects-heading">CÔNG TRÌNH THỰC TẾ</h2></div><a class="pv3-text-link" href="/du-an/">Xem công trình IST <span aria-hidden="true">↗</span></a></div>
    <div class="pv3-project-grid">{projects.map((project) => <a class="pv3-project" href="/du-an/"><div class="pv3-media-frame"><Media src={project.image} alt={project.imageAlt} width={project.imageWidth} height={project.imageHeight} /></div><div class="pv3-project-caption"><div><p>{project.category}</p><h3>{project.title}</h3></div><span aria-hidden="true">↗</span></div></a>)}</div>
  </div>
</section>

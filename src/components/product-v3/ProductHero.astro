---
import Media from '../home-v3/Media.astro'
const { eyebrow, lines, description, media, location, service, primary, secondary } = Astro.props
---
<section class:list={['pv3-hero', 'hv3-container', { 'pv3-hero-with-media': media }]} data-v3-contact-area aria-labelledby="hero-heading">
  <div class="pv3-hero-copy">
    <p class="hv3-eyebrow"><span class="hv3-marker" aria-hidden="true"></span>{eyebrow}</p>
    <h1 id="hero-heading">{lines.map((line, index) => <><span>{line}</span>{index < lines.length - 1 && ' '}</>)}</h1>
    {media && <p class="pv3-introduction hv3-body">{description}</p>}
    {media && <div class="hv3-actions">
      <a class="hv3-button hv3-button-ink" href={primary.href} data-track-event="service_cta_click" data-track-location={location} data-track-service={service} data-track-action={primary.action}>{primary.label} <span aria-hidden="true">↗</span></a>
      <a class="hv3-text-link" href={secondary.href} data-track-event="service_cta_click" data-track-location={location} data-track-service={service} data-track-action={secondary.action}>{secondary.label} <span aria-hidden="true">↗</span></a>
    </div>}
  </div>
  {media ? <figure class="pv3-hero-media"><div class="hv3-media-frame"><Media {...media} eager={true} /></div><figcaption>BẢNG HIỆU DO IST THỰC HIỆN</figcaption></figure> : <div class="pv3-hero-intro"><p class="pv3-introduction hv3-body">{description}</p><div class="hv3-actions"><a class="hv3-text-link" href={primary.href} data-track-event="service_cta_click" data-track-location={location} data-track-action={primary.action}>{primary.label} <span aria-hidden="true">↓</span></a><a class="hv3-text-link" href={secondary.href} data-track-event="service_cta_click" data-track-location={location} data-track-action={secondary.action}>{secondary.label} <span aria-hidden="true">↗</span></a></div></div>}
</section>

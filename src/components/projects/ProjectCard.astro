---
const { project } = Astro.props
---

<article class="min-w-0 overflow-hidden rounded-3xl border border-zinc-800 bg-black" aria-labelledby={project.slug}>
  <a href={project.image} data-project-image data-project-slug={project.slug} data-caption={project.caption} class="block text-white focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-orange-400" aria-label={`Xem ảnh lớn: ${project.title}`}>
    <img src={project.image} width={project.imageWidth} height={project.imageHeight} alt={project.imageAlt} loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
    <span class="inline-flex min-h-12 items-center px-6 py-3 text-sm font-bold text-orange-400 underline underline-offset-4">Xem ảnh lớn <span aria-hidden="true" class="ml-2">↗</span></span>
  </a>
  <div class="px-6 pb-7 md:px-7">
    <p class="mb-3 text-sm font-semibold text-zinc-400">{project.category}</p>
    <h2 id={project.slug} class="text-2xl leading-tight font-bold text-white">{project.title}</h2>
    <p class="mt-3 leading-relaxed text-zinc-400">{project.summary}</p>
    <p class="mt-4 border-t border-zinc-800 pt-4 text-sm leading-relaxed text-zinc-300"><span class="font-bold text-orange-400">IST thực hiện:</span> {project.service}</p>
    {project.serviceHref && <a href={project.serviceHref} data-track-event="service_cta_click" data-track-location="project_card" data-track-service="bang_hieu" data-track-action="view_service" class="mt-4 inline-flex min-h-12 items-center py-3 font-bold text-orange-400 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange-400">Dịch vụ bảng hiệu <span aria-hidden="true" class="ml-2">→</span></a>}
  </div>
</article>

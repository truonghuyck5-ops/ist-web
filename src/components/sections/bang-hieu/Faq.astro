---
import { bangHieuFaqs as faqs } from '../../../data/bangHieuFaqs.js'
---

<section class="border-t border-zinc-900 bg-zinc-950">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <div class="mb-16 text-center">
      <p class="mb-4 font-semibold tracking-wide text-orange-500 uppercase">Câu hỏi thường gặp</p>
      <h2 class="text-4xl leading-tight font-bold text-white md:text-5xl">Những điều khách thường hỏi<br />trước khi làm bảng hiệu</h2>
    </div>
    <div class="space-y-5">
      {faqs.map(([question, answer]) => (
        <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 transition hover:border-orange-500">
          <h3 class="mb-3 text-xl font-bold text-white">{question}</h3>
          <p class="leading-relaxed text-gray-400">{answer}</p>
        </article>
      ))}
    </div>
  </div>
</section>

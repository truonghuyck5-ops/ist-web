---
const faqs = [
  ['Làm bảng hiệu cần cung cấp thông tin gì?', 'Khách hàng nên cung cấp kích thước dự kiến, vị trí lắp đặt, hình ảnh mặt tiền, mẫu tham khảo và ngân sách mong muốn để IST tư vấn phương án phù hợp.'],
  ['IST có khảo sát công trình không?', 'Có. Với các công trình cần thi công thực tế, IST có thể khảo sát vị trí, đo đạc và đánh giá kết cấu để báo giá chính xác hơn.'],
  ['Bảng hiệu alu, hiflex và hộp đèn khác nhau thế nào?', 'Hiflex phù hợp nhu cầu tiết kiệm hoặc ngắn hạn. Alu và tol dán decal phù hợp mặt tiền shop cần hình ảnh đẹp. Hộp đèn giúp bảng hiệu nổi bật vào ban đêm.'],
  ['Thời gian thi công bảng hiệu mất bao lâu?', 'Tùy kích thước và độ phức tạp, thông thường IST cần vài ngày để thiết kế, sản xuất và sắp xếp thi công. Công trình lớn sẽ có tiến độ riêng.'],
  ['IST có hỗ trợ thiết kế bảng hiệu không?', 'Có. IST hỗ trợ thiết kế bảng hiệu theo ngành nghề, mặt tiền thực tế và phong cách thương hiệu của khách hàng.'],
  ['Báo giá bảng hiệu phụ thuộc vào yếu tố nào?', 'Giá phụ thuộc vào kích thước, vật liệu, kết cấu khung, độ cao thi công, vị trí lắp đặt, đèn LED, chữ nổi và yêu cầu hoàn thiện.'],
]
---

<section class="border-t border-zinc-900 bg-zinc-950">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <div class="mb-16 text-center">
      <p class="mb-4 font-semibold tracking-wide text-orange-500 uppercase">Câu hỏi thường gặp</p>
      <h2 class="text-4xl leading-tight font-bold text-white md:text-5xl">Những điều khách thường hỏi<br />trước khi làm bảng hiệu</h2>
    </div>
    <div class="space-y-5">
      {faqs.map(([question, answer]) => (
        <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6 transition hover:border-orange-500">
          <h3 class="mb-3 text-xl font-bold text-white">{question}</h3>
          <p class="leading-relaxed text-gray-400">{answer}</p>
        </article>
      ))}
    </div>
  </div>
</section>

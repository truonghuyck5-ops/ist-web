---
import { bangHieuPricing } from '../../../data/bangHieuPricing.js'
---

<section class="border-t border-zinc-900">
  <div class="mx-auto max-w-7xl px-6 py-24">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <p class="mb-4 font-semibold tracking-wide text-orange-500 uppercase">Báo giá tham khảo</p>
      <h2 class="mb-6 text-4xl leading-tight font-bold text-white md:text-5xl">Một số mức giá bảng hiệu phổ biến</h2>
      <p class="text-lg leading-relaxed text-gray-400">Giá thực tế phụ thuộc kích thước, vật liệu, vị trí lắp đặt, kết cấu khung và yêu cầu thi công tại công trình.</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      {bangHieuPricing.map((item) => (
        <article class:list={['rounded-3xl border p-8 transition duration-300', item.featured ? 'border-orange-500 bg-orange-500/5 lg:scale-105' : 'border-zinc-800 bg-zinc-900']}>
          {item.featured && <p class="mb-6 inline-block rounded-full bg-orange-500 px-4 py-1 text-sm text-white">Phổ biến</p>}
          <h3 class="mb-4 text-3xl font-bold text-white">{item.title}</h3>
          <p class="mb-6 text-4xl font-black text-orange-500">{item.price}</p>
          <p class="mb-8 leading-relaxed text-gray-400">{item.description}</p>
          <ul class="mb-10 space-y-4">{item.features.map((feature) => <li class="flex items-start gap-3"><span class="text-orange-500">✓</span><span class="text-gray-300">{feature}</span></li>)}</ul>
          <a href="#contact" class:list={['inline-flex rounded-xl px-8 py-4 font-semibold transition duration-300', item.featured ? 'bg-orange-500 text-white hover:bg-orange-600' : 'border border-gray-700 text-white hover:border-orange-500 hover:text-orange-500']}>Nhận tư vấn &amp; báo giá</a>
        </article>
      ))}
    </div>

    <p class="mt-10 text-center text-sm text-gray-500">* Giá trên chỉ mang tính tham khảo. IST sẽ khảo sát hoặc xem hình thực tế để báo giá chính xác.</p>
  </div>
</section>

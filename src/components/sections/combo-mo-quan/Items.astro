---
import { comboItems } from '../../../data/comboItems.js'
---

<section id="combo-items" class="border-t border-zinc-900">
  <div class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-16 max-w-3xl">
      <p class="mb-4 font-semibold tracking-wide text-orange-500 uppercase">Hạng mục trong combo</p>
      <h2 class="mb-6 text-4xl leading-tight font-bold text-white md:text-5xl">Một bộ nhận diện cơ bản<br />cho quán mới</h2>
      <p class="text-lg leading-relaxed text-gray-400">IST giúp chủ quán chuẩn bị các hạng mục thiết yếu để khai trương chuyên nghiệp, đồng bộ và dễ bán hàng hơn.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {comboItems.map((item) => (
        <article class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900 transition duration-300 hover:-translate-y-2 hover:border-orange-500">
          <button type="button" data-lightbox={item.image} data-caption={item.title} class="block h-56 w-full overflow-hidden" aria-label={`Xem ảnh lớn: ${item.title}`}>
            <img src={item.image} alt={item.title} loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 group-hover:scale-110" />
          </button>
          <div class="p-8">
            <h3 class="mb-4 text-2xl font-bold text-white">{item.title}</h3>
            <p class="leading-relaxed text-gray-400">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

---
import { hoaDonFaqs as faqs } from '../../../data/hoaDonFaqs.js'
---

<section id="faq" class="border-t border-zinc-900 bg-black py-20 text-white"><div class="mx-auto max-w-4xl px-6"><div class="mb-10 text-center"><p class="mb-4 font-semibold tracking-[0.2em] text-orange-500 uppercase">FAQ</p><h2 class="text-4xl font-black md:text-5xl">Câu hỏi thường gặp</h2></div><div class="grid gap-4">{faqs.map(([question, answer]) => (<article class="rounded-3xl border border-zinc-800 bg-zinc-900 p-6"><h3 class="mb-3 text-xl font-black text-white">{question}</h3><p class="leading-relaxed text-gray-400">{answer}</p></article>))}</div></div></section>

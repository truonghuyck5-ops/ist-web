---import { hoaDonPricingConfig as config } from '../../../data/hoaDonPricingConfig'
import {
  calculateHoaDonQuote,
  getPlyOptions,
  getQuantityOptions,
  getSizeOptions,
} from '../../../utils/hoaDonCalculatorLogic'

const sizeOptions = getSizeOptions()
const plyOptions = getPlyOptions()
const quantityOptions = getQuantityOptions(config.default.size, config.default.ply)
const defaultQuantity = quantityOptions[0]?.value
const defaultQuote = calculateHoaDonQuote({
  ...config.default,
  quantity: defaultQuantity,
})---
<section id="calculator" class="hv3-section hv3-soft iv3-calculator" data-v3-contact-area aria-labelledby="calculator-heading">
  <div class="hv3-container">
    <div class="hv3-section-head" data-iv3-calculator-heading><div><p class="hv3-eyebrow">01 / BÁO GIÁ TRỰC TUYẾN</p><h2 id="calculator-heading">CHỌN QUY CÁCH.<br />XEM GIÁ NGAY.</h2></div><p class="hv3-body pv3-section-note">Chọn khổ giấy, số liên và số lượng.<br />Giá tham khảo tự cập nhật theo lựa chọn.</p></div>
    <div class="iv3-calculator-content">
      <form id="invoice-calculator-form" class="iv3-fields" aria-label="Quy cách hóa đơn và biểu mẫu">
        <div><label for="invoice-size"><span>01</span> Khổ giấy</label><select id="invoice-size">{sizeOptions.map(option => <option value={option.value} selected={option.value === config.default.size}>{option.label}</option>)}</select></div>
        <div><label for="invoice-ply"><span>02</span> Số liên</label><select id="invoice-ply">{plyOptions.map(option => <option value={option.value} selected={option.value === config.default.ply}>{option.label}</option>)}</select></div>
        <div><label for="invoice-quantity"><span>03</span> Số lượng</label><select id="invoice-quantity">{quantityOptions.map(option => <option value={option.value}>{option.label}</option>)}</select></div>
      </form>
      <div id="invoice-result" class="iv3-result" aria-live="polite" aria-atomic="true">
        <p class="hv3-eyebrow">GIÁ THEO QUY CÁCH</p>
        <dl class="iv3-prices"><div><dt>Đơn giá / cuốn</dt><dd id="invoice-unit-price">{defaultQuote?.unitPriceText ?? '-'}</dd></div><div><dt>Tổng tiền</dt><dd id="invoice-total-price">{defaultQuote?.totalPriceText ?? '-'}</dd></div></dl>
        <p id="invoice-info">{defaultQuote && <><strong>{defaultQuote.quantity.toLocaleString('vi-VN')} cuốn</strong><span> - {defaultQuote.size} / {defaultQuote.plyLabel} - Thành phẩm khoảng {defaultQuote.finishedSize}</span></>}</p>
        <p id="invoice-note">{defaultQuote?.note ?? ''}</p>
        <div class="iv3-calculator-actions"><a id="invoice-zalo-btn" href="https://zalo.me/0974313230" data-track-event="zalo_click" data-track-location="hoa_don_calculator" data-track-service="hoa_don" target="_blank" rel="noopener noreferrer" class="hv3-button hv3-button-ink">Nhắn Zalo <span aria-hidden="true">↗</span></a><button id="invoice-price-table-btn" type="button" class="hv3-button iv3-table-button">Bảng giá số lượng <span aria-hidden="true">↗</span></button></div>
      </div>
      <p class="iv3-calculator-note">Các mốc số lượng được thiết kế để hạn chế lẻ ream giấy. Nếu cần số lượng khác bảng, IST sẽ tư vấn riêng để tối ưu chi phí.</p>
    </div>
  </div>
  <div id="invoice-price-popup" class="iv3-price-popup hidden" role="dialog" aria-modal="true" aria-labelledby="invoice-popup-title" aria-describedby="invoice-popup-subtitle" aria-hidden="true">
    <div id="invoice-price-popup-overlay" class="iv3-popup-overlay"></div>
    <div class="iv3-popup-card"><div class="iv3-popup-head"><div><p class="hv3-eyebrow">BẢNG GIÁ THEO SỐ LƯỢNG</p><h3 id="invoice-popup-title">-</h3><p id="invoice-popup-subtitle">-</p></div><button id="invoice-price-popup-close" type="button" aria-label="Đóng bảng giá">Đóng</button></div><div class="iv3-popup-body"><div class="iv3-table-heading"><span>Số lượng</span><span>Đơn giá</span><span>Thành tiền</span></div><div id="invoice-price-table-body" class="iv3-price-rows"></div><p id="invoice-popup-note">-</p></div></div>
  </div>
</section>

---
import { hoaDonGallery, hoaDonGalleryFilters } from '../../../data/hoaDonGallery.js'

const initial = hoaDonGallery[0]
const sizeFilters = hoaDonGalleryFilters.slice(0, 4)
const inkFilters = hoaDonGalleryFilters.slice(4)
---

<div id="hoa-don-gallery" class="rounded-3xl border border-zinc-800 bg-zinc-900 p-5 md:p-6">
  <div class="relative overflow-hidden rounded-2xl border border-zinc-800 bg-black">
    <button id="hoa-don-gallery-open" type="button" class="block w-full" aria-label="Xem ảnh lớn: In hóa đơn - Phiếu thu - Biểu mẫu IST">
      <img id="hoa-don-gallery-image" src={initial.src} alt={initial.title} class="aspect-[4/3] w-full object-cover" />
    </button>
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 to-transparent p-4">
      <div class="flex items-end justify-between gap-4"><div><p id="hoa-don-gallery-title" class="font-bold text-white">{initial.title}</p><p id="hoa-don-gallery-group" class="mt-1 text-sm text-gray-400">Đang xem: Tất cả mẫu</p></div><p id="hoa-don-gallery-counter" class="shrink-0 rounded-full border border-zinc-700 bg-black/70 px-3 py-1 text-xs text-gray-300">1/{hoaDonGallery.length}</p></div>
    </div>
    <button id="hoa-don-gallery-prev" type="button" class="absolute top-1/2 left-3 h-10 w-10 -translate-y-1/2 rounded-full border border-zinc-700 bg-black/70 text-white transition hover:border-orange-500 hover:bg-orange-500" aria-label="Ảnh trước">‹</button>
    <button id="hoa-don-gallery-next" type="button" class="absolute top-1/2 right-3 h-10 w-10 -translate-y-1/2 rounded-full border border-zinc-700 bg-black/70 text-white transition hover:border-orange-500 hover:bg-orange-500" aria-label="Ảnh tiếp theo">›</button>
  </div>

  <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {sizeFilters.map((filter) => (
      <button type="button" data-invoice-gallery-filter={filter.value} aria-pressed={filter.value === 'all' ? 'true' : 'false'} class:list={['rounded-2xl border p-4 text-left transition hover:border-orange-500', filter.value === 'all' ? 'border-orange-500 bg-orange-500 text-white' : 'border-zinc-700 bg-black text-gray-300']}><span class:list={['block font-black', filter.value === 'all' ? 'text-xl' : 'text-2xl']}>{filter.label}</span><span class="mt-1 block text-sm">{filter.description}</span></button>
    ))}
  </div>
  <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
    {inkFilters.map((filter) => (
      <button type="button" data-invoice-gallery-filter={filter.value} aria-pressed="false" class="rounded-xl border border-zinc-700 bg-black px-4 py-3 text-sm font-bold text-gray-300 transition hover:border-orange-500 hover:text-orange-500">{filter.label}</button>
    ))}
  </div>
  <p id="hoa-don-gallery-empty" class="mt-4 hidden text-sm text-gray-400" aria-live="polite"></p>
</div>

<div id="hoa-don-lightbox" class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/85 p-4" role="dialog" aria-modal="true" aria-label="Xem mẫu hóa đơn lớn" aria-hidden="true">
  <div id="hoa-don-lightbox-overlay" class="absolute inset-0"></div>
  <div class="relative z-10 w-full max-w-5xl"><button id="hoa-don-lightbox-close" type="button" class="absolute -top-12 right-0 rounded-xl border border-zinc-700 bg-black px-4 py-2 text-sm font-bold text-white transition hover:border-orange-500 hover:text-orange-500">Đóng</button><img id="hoa-don-lightbox-image" src={initial.src} alt="Xem mẫu hóa đơn lớn" class="max-h-[82vh] w-full rounded-2xl border border-zinc-800 bg-black object-contain" /><p id="hoa-don-lightbox-title" class="mt-3 text-center font-bold text-white">{initial.title}</p></div>
</div>

<script define:vars={{ hoaDonGallery, hoaDonGalleryFilters }}>
  window.__hoaDonGallery = hoaDonGallery
  window.__hoaDonGalleryFilters = hoaDonGalleryFilters
</script>

---
const proofBlocks = [
  ['01', 'Tư vấn & thiết kế', 'Tư vấn giải pháp theo nhu cầu thực tế và hỗ trợ thiết kế cơ bản cho in ấn, bảng hiệu, tem nhãn, menu, banner cùng các ấn phẩm quảng cáo.'],
  ['02', 'In ấn & gia công tại xưởng', 'In tem nhãn, danh thiếp, tag, voucher, thiệp mời, hóa đơn, biểu mẫu và ấn phẩm giấy; in bạt hiflex, decal, PP, backdrop, banner, standee, poster; đồng thời gia công mica, alu, fomex, chữ nổi bằng hệ thống máy tại xưởng.'],
  ['03', 'Sản xuất bảng hiệu', 'Sản xuất khung sắt, mặt bảng, hộp đèn, chữ nổi, bảng hiệu alu, bảng hiệu decal, bảng hiệu công trình và các hạng mục quảng cáo ngoài trời.'],
  ['04', 'Thi công & bàn giao', 'Đội ngũ IST trực tiếp vận chuyển, lắp đặt, thi công và bàn giao công trình cho shop, doanh nghiệp, cơ quan, trường học và tổ chức.'],
]
---

<section id="capabilities" class="border-t border-zinc-800 bg-zinc-950" data-reveal>
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
    <div class="mb-10 grid gap-6 lg:mb-12 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="max-w-3xl lg:col-span-7">
        <p class="mb-3 text-sm font-bold tracking-[0.18em] text-orange-500 uppercase">Vì sao chọn IST</p>
        <h2 class="text-3xl leading-tight font-black text-white md:text-4xl">Chủ động từ thiết kế đến sản xuất và thi công</h2>
      </div>
      <p class="max-w-xl text-base leading-relaxed text-zinc-400 lg:col-span-5 lg:pb-1">IST kết nối tư vấn, in ấn, gia công, sản xuất bảng hiệu và thi công trong cùng một quy trình để xử lý từng hạng mục theo nhu cầu thực tế.</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {proofBlocks.map(([number, title, description]) => (
        <article class="rounded-3xl border border-zinc-800 bg-black p-6 md:p-7">
          <div class="mb-6 flex items-center gap-4"><span class="text-4xl font-black text-orange-500/50">{number}</span><span class="h-px flex-1 bg-zinc-800"></span></div>
          <h3 class="text-xl font-black text-white">{title}</h3>
          <p class="mt-3 max-w-2xl leading-relaxed text-zinc-400">{description}</p>
        </article>
      ))}
    </div>

    <div class="mt-8">
      <a href="#projects" class="inline-flex min-h-12 items-center rounded-xl border border-zinc-700 px-6 py-3 font-bold text-white hover:border-orange-500 hover:text-orange-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500">Xem công trình đã thực hiện <span aria-hidden="true" class="ml-2">→</span></a>
    </div>
  </div>
</section>

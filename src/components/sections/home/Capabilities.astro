---
const capabilities = [
  ['01', 'Thiết kế & tư vấn', 'Tư vấn giải pháp phù hợp theo nhu cầu thực tế của khách hàng. Hỗ trợ thiết kế cơ bản cho in ấn, bảng hiệu, tem nhãn, menu, banner và các ấn phẩm quảng cáo.'],
  ['02', 'In nhanh & tem nhãn', 'Chủ động in tem nhãn, danh thiếp, tag, voucher, thiệp mời, hóa đơn, biểu mẫu và các ấn phẩm giấy với hệ thống máy in nhanh tại xưởng.'],
  ['03', 'In khổ lớn', 'In bạt hiflex, decal, PP, backdrop, banner, standee, poster và vật liệu phục vụ bảng hiệu, sự kiện, khai trương, đại hội, hội nghị.'],
  ['04', 'CNC - Laser - Gia công', 'Gia công mica, alu, fomex, chữ nổi, vật liệu trang trí, chi tiết bảng hiệu và các hạng mục quảng cáo bằng hệ thống CNC, laser tại xưởng.'],
  ['05', 'Sản xuất bảng hiệu', 'Sản xuất khung sắt, mặt bảng, hộp đèn, chữ nổi, bảng hiệu alu, bảng hiệu decal, bảng hiệu công trình và các hạng mục quảng cáo ngoài trời.'],
  ['06', 'Thi công & bàn giao', 'Đội ngũ IST trực tiếp vận chuyển, lắp đặt, thi công và bàn giao công trình cho shop, doanh nghiệp, cơ quan, trường học và tổ chức.'],
]
---

<section id="capabilities" class="border-t border-gray-900 bg-zinc-950" data-reveal>
  <div class="mx-auto max-w-7xl px-6 py-24">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="mb-5 font-semibold tracking-widest text-orange-500 uppercase">Năng lực IST</p>
        <h2 class="mb-8 text-3xl leading-tight font-black text-white md:text-5xl">Chủ động từ thiết kế,<br />sản xuất đến thi công</h2>
        <p class="mb-8 text-lg leading-relaxed text-gray-400">IST không chỉ nhận đơn hàng rồi chuyển gia công bên ngoài. Chúng tôi từng bước xây dựng năng lực sản xuất thật tại xưởng, giúp chủ động hơn về tiến độ, chất lượng và khả năng phục vụ khách hàng.</p>
        <a href="#projects" class="inline-flex items-center rounded-xl bg-orange-500 px-6 py-4 font-bold text-white transition hover:bg-orange-600">Xem công trình thực tế</a>
      </div>
      <div class="lg:col-span-8">
        <div class="grid gap-5 md:grid-cols-2">
          {capabilities.map(([number, title, description]) => (
            <article class="group rounded-3xl border border-zinc-800 bg-black p-7 transition hover:border-orange-500/70">
              <div class="mb-6 flex items-center gap-4"><span class="text-4xl font-black text-orange-500/30 transition group-hover:text-orange-500">{number}</span><span class="h-px flex-1 bg-zinc-800 transition group-hover:bg-orange-500/50"></span></div>
              <h3 class="mb-4 text-xl font-bold text-white">{title}</h3>
              <p class="leading-relaxed text-gray-400">{description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

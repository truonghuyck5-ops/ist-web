---
import { featuredProjects } from '../../../data/featuredProjects.js'

const homepageProjects = featuredProjects.filter((project) => project.homepageFeatured)
---

<section id="projects" class="border-t border-zinc-800 bg-zinc-950" data-reveal>
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
    <div class="mb-10 grid items-end gap-6 lg:mb-12 lg:grid-cols-12 lg:gap-8">
      <div class="max-w-3xl lg:col-span-8">
        <p class="mb-3 text-sm font-bold tracking-[0.18em] text-orange-500 uppercase">Công trình thực tế</p>
        <h2 class="text-3xl leading-tight font-black text-white md:text-4xl">Một số công trình IST đã thực hiện</h2>
        <p class="mt-4 text-base leading-relaxed text-zinc-400">Hình ảnh các hạng mục IST trực tiếp thiết kế, sản xuất và thi công cho khách hàng thực tế.</p>
      </div>
      <div class="lg:col-span-4 lg:text-right"><a href="#contact" class="inline-flex min-h-12 items-center rounded-xl border border-zinc-700 px-6 py-3 font-bold text-white hover:border-orange-500 hover:text-orange-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500">Nhận tư vấn hạng mục tương tự <span aria-hidden="true" class="ml-2">→</span></a></div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {homepageProjects.map((project) => (
        <article class="overflow-hidden rounded-3xl border border-zinc-800 bg-black">
          <div class="relative overflow-hidden">
            <button type="button" data-lightbox={project.image} data-lightbox-group="featured-projects" data-caption={project.caption} class="block aspect-[4/3] w-full focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-orange-500 md:aspect-[16/10]" aria-label={`Xem ảnh lớn: ${project.title}`}>
              <img src={project.image} width={project.imageWidth} height={project.imageHeight} alt={project.imageAlt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </button>
            <p class="absolute top-4 left-4 rounded-full bg-black/80 px-3 py-1.5 text-xs font-bold text-white">{project.category}</p>
          </div>
          <div class="p-6 md:p-7">
            <h3 class="text-2xl leading-tight font-black text-white">{project.title}</h3>
            <p class="mt-3 text-zinc-400">{project.summary}</p>
            <p class="mt-4 border-t border-zinc-800 pt-4 text-sm leading-relaxed text-zinc-300"><span class="font-bold text-orange-400">IST thực hiện:</span> {project.service}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

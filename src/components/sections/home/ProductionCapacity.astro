---
const machineGroups = [
  ['In nhanh & tem nhãn', 'Máy in nhanh Konica C2060L, máy bế tem nhãn tự động Saga, máy photo màu và máy cắt giấy phục vụ tem nhãn, card, tag, voucher, thiệp mời cùng ấn phẩm giấy.'],
  ['In khổ lớn', 'Máy in bạt 3m2, máy in decal 1m6 và máy cán màng 1m6 phục vụ banner, backdrop, decal, PP cùng vật liệu bảng hiệu.'],
  ['CNC, laser & gia công', 'Máy CNC 130x250, laser 130x90 và 60x40 hỗ trợ gia công mica, alu, fomex, chữ nổi, chi tiết trang trí và hạng mục bảng hiệu.'],
  ['Sản xuất & thi công', 'Khu sản xuất bảng hiệu có máy hàn, máy cắt, dụng cụ cơ khí, xe tải giao hàng và đội thi công trực tiếp tại công trình.'],
]

const gallery = [
  ['/images/home/may-in-nhanh-konica.webp', 'Máy in nhanh Konica tại IST', 'Máy in nhanh Konica C2060L tại xưởng IST', '810', '1080', 'aspect-[4/3]'],
  ['/images/home/may-in-bat-kho-lon.webp', 'Máy in bạt khổ lớn tại IST', 'Máy in bạt khổ lớn phục vụ banner, backdrop và bảng hiệu', '1910', '1076', 'aspect-[4/3]'],
  ['/images/home/may-cnc-laser-ist.webp', 'Máy CNC và laser tại IST', 'Hệ thống CNC và laser phục vụ gia công bảng hiệu, mica, alu, fomex', '1215', '911', 'aspect-[4/3]'],
  ['/images/home/khu-san-xuat-thi-cong-ist.webp', 'Khu sản xuất và thi công bảng hiệu IST', 'Khu sản xuất, gia công và thi công bảng hiệu tại IST', '1215', '911', 'aspect-[4/3]'],
  ['/images/home/san-xuat-hoa-don.webp', 'Khu vực sản xuất hóa đơn, biểu mẫu', 'Khu vực sản xuất hóa đơn, biểu mẫu', '2560', '1920', 'aspect-[4/3]'],
]
---

<section id="factory" class="border-t border-zinc-800 bg-black" data-reveal>
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-12">
      <div class="max-w-3xl lg:col-span-5">
        <p class="mb-3 text-sm font-bold tracking-[0.18em] text-orange-500 uppercase">Bằng chứng sản xuất</p>
        <h2 class="text-3xl leading-tight font-black text-white md:text-4xl">Nhà xưởng, máy móc và đội ngũ trực tiếp</h2>
        <p class="mt-4 text-base leading-relaxed text-zinc-400">Các nhóm máy và khu sản xuất dưới đây phục vụ in ấn, gia công, sản xuất bảng hiệu và thi công thực tế của IST.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
        {gallery.slice(0, 4).map(([src, alt, caption, width, height, classes]) => (
          <button type="button" data-lightbox={src} data-lightbox-group="production-proof" data-caption={caption} class:list={['block w-full overflow-hidden rounded-2xl bg-zinc-900 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500', classes]} aria-label={`Xem ảnh lớn: ${alt}`}>
            <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
          </button>
        ))}
      </div>
    </div>

    <div class="mt-8 grid gap-5 md:mt-10 md:grid-cols-2">
      {machineGroups.map(([title, description]) => (
        <article class="rounded-2xl border border-zinc-800 bg-zinc-900 p-5 md:p-6">
          <h3 class="text-lg font-black text-white">{title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-zinc-400">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

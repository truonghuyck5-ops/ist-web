---
import { homeServices } from '../../../data/homeServices.js'

const primaryServices = homeServices.filter((service) => service.tier === 'primary')
const secondaryServices = homeServices.filter((service) => service.tier === 'secondary')
---

<section id="products" class="border-t border-stone-200 bg-stone-100" data-reveal>
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
    <div class="mb-10 grid gap-5 lg:mb-12 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="max-w-3xl lg:col-span-7">
        <p class="mb-3 text-sm font-bold tracking-[0.18em] text-orange-600 uppercase">Dịch vụ IST</p>
        <h2 class="text-3xl leading-tight font-black text-zinc-950 md:text-4xl">Giải pháp in ấn &amp; quảng cáo cho từng nhu cầu</h2>
      </div>
      <p class="max-w-xl text-base leading-relaxed text-zinc-600 lg:col-span-5 lg:pb-1">Từ hạng mục nhận diện cho cửa hàng đến ấn phẩm vận hành, IST triển khai trực tiếp tại xưởng và tư vấn theo nhu cầu thực tế.</p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {primaryServices.map((service) => (
        <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm hover:border-orange-300 hover:shadow-md">
          <div class="relative overflow-hidden bg-stone-200">
            <button type="button" data-lightbox={service.image} data-caption={`${service.title} - Dịch vụ tại IST`} class="block aspect-[4/3] w-full focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-orange-600" aria-label={`Xem ảnh lớn: ${service.title}`}>
              <img src={service.image} width={service.imageWidth} height={service.imageHeight} alt={service.imageAlt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </button>
            <span class="absolute top-3 left-3 rounded-full bg-zinc-950/85 px-3 py-1.5 text-[0.68rem] font-bold tracking-wide text-white">{service.tag}</span>
          </div>
          <div class="flex flex-1 flex-col p-5">
            <p class="mb-2 text-xs font-bold tracking-[0.14em] text-orange-700 uppercase">Dịch vụ chủ lực</p>
            <h3 class="text-xl leading-tight font-black text-zinc-950">{service.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-600">{service.desc}</p>
            {service.astroRouteAvailable ? (
              <a href={service.href} data-track-event="service_cta_click" data-track-location="home_service_card" data-track-service={service.trackingService} data-track-action="view_service" class="mt-5 inline-flex min-h-11 items-center font-bold text-orange-700 hover:text-orange-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600">Xem chi tiết <span aria-hidden="true" class="ml-2">→</span></a>
            ) : (
              <a href="#contact" data-track-event="service_cta_click" data-track-location="home_service_card" data-track-service={service.trackingService} data-track-action="quote_request" class="mt-5 inline-flex min-h-11 items-center font-bold text-orange-700 hover:text-orange-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600">Nhận tư vấn <span aria-hidden="true" class="ml-2">→</span></a>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10 border-t border-stone-300 pt-8 md:mt-12">
      <div class="mb-5 flex items-center gap-3">
        <p class="text-sm font-bold tracking-[0.14em] text-zinc-600 uppercase">Dịch vụ bổ trợ</p>
        <span class="h-px flex-1 bg-stone-300" aria-hidden="true"></span>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {secondaryServices.map((service) => (
          <article class="flex gap-4 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm sm:p-5">
            <img src={service.image} width={service.imageWidth} height={service.imageHeight} alt={service.imageAlt} loading="lazy" decoding="async" class="h-20 w-20 shrink-0 rounded-xl object-cover sm:h-24 sm:w-28" />
            <div class="min-w-0">
              <h3 class="text-lg font-black text-zinc-950">{service.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-zinc-600">{service.desc}</p>
              {service.astroRouteAvailable ? (
                <a href={service.href} data-track-event="service_cta_click" data-track-location="home_service_card" data-track-service={service.trackingService} data-track-action="view_service" class="mt-3 inline-flex min-h-10 items-center font-bold text-orange-700 hover:text-orange-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600">Xem chi tiết <span aria-hidden="true" class="ml-2">→</span></a>
              ) : (
                <a href="#contact" data-track-event="service_cta_click" data-track-location="home_service_card" data-track-service={service.trackingService} data-track-action="quote_request" class="mt-3 inline-flex min-h-10 items-center font-bold text-orange-700 hover:text-orange-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600">Nhận tư vấn <span aria-hidden="true" class="ml-2">→</span></a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

---
import { temNhanGallery } from '../../../data/temNhanGallery.js'
---

<section id="tem-nhan-gallery" class="border-t border-zinc-900 bg-black">
  <div class="mx-auto max-w-7xl px-6 py-24">
    <div class="mb-14 max-w-3xl">
      <p class="mb-4 font-semibold tracking-wide text-orange-500 uppercase">Mẫu tem nhãn thực tế</p>
      <h2 class="mb-6 text-4xl leading-tight font-black text-white md:text-5xl">Một số mẫu tem nhãn<br />IST có thể sản xuất</h2>
      <p class="text-lg leading-relaxed text-gray-400">IST nhận in tem nhãn decal cho shop, cơ sở sản xuất, sản phẩm handmade, mỹ phẩm, thực phẩm, nông sản và nhiều nhóm hàng kinh doanh khác.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {temNhanGallery.map((item) => (
        <article class="group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-950 transition hover:border-orange-500/70">
          <button type="button" data-lightbox={item.image} data-caption={item.title} class="block aspect-square w-full overflow-hidden" aria-label={`Xem ảnh lớn: ${item.title}`}><img src={item.image} alt={item.title} loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-500 group-hover:scale-110" /></button>
          <div class="p-6"><h3 class="mb-3 text-xl font-bold text-white">{item.title}</h3><p class="leading-relaxed text-gray-400">{item.desc}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>

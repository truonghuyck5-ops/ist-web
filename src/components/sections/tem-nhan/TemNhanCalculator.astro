---
import { temNhanPricingConfig as config } from '../../../data/temNhanPricingConfig.js'
---
<section id="calculator" class="hv3-section hv3-soft tv3-calculator" data-v3-contact-area aria-labelledby="calculator-heading">
  <div class="hv3-container">
    <div class="hv3-section-head" data-tv3-calculator-heading>
      <div><p class="hv3-eyebrow">01 / BÁO GIÁ TRỰC TUYẾN</p><h2 id="calculator-heading">TÍNH GIÁ TEM NHÃN.</h2></div>
      <p class="hv3-body pv3-section-note">Nhập kích thước, chất liệu và số lượng.<br />Giá tham khảo tự cập nhật theo lựa chọn.</p>
    </div>
    <div id="tem-nhan-calculator-form" class="tv3-calculator-grid">
      <div class="tv3-fields">
        <fieldset><legend><span>01</span> Kích thước tem</legend><div class="tv3-dimensions">
          <div><label for="width">Chiều ngang tem (mm)</label><input id="width" type="number" inputmode="numeric" min={config.minSize} max={config.maxSize} placeholder="Ví dụ: 50" /></div>
          <div><label for="height">Chiều cao tem (mm)</label><input id="height" type="number" inputmode="numeric" min={config.minSize} max={config.maxSize} placeholder="Ví dụ: 50" /></div>
        </div><p class="tv3-field-note">Kích thước hợp lệ từ {config.minSize}mm đến {config.maxSize}mm.</p></fieldset>
        <fieldset><legend><span>02</span> Chất liệu</legend><label for="decal-type">Loại decal</label><select id="decal-type">{Object.entries(config.materials).map(([value, material]) => <option value={value}>{material.label}</option>)}</select></fieldset>
        <fieldset><legend><span>03</span> Số lượng</legend><label for="quantity">Số lượng tem</label><input id="quantity" type="number" inputmode="numeric" min="1" placeholder="Ví dụ: 1000" /></fieldset>
        <fieldset><legend><span>04</span> Gia công</legend><label for="lamination">Cán màng</label><select id="lamination">{Object.entries(config.laminationFees).map(([value, film]) => <option value={value}>{film.label}</option>)}</select></fieldset>
        <div class="tv3-calculator-actions"><button id="export-quote-btn" type="button" class="hv3-button hv3-button-ink">Xuất báo giá <span aria-hidden="true">↗</span></button><button id="reset-quote-btn" type="button" class="hv3-button tv3-reset">Làm mới</button></div>
        <p class="tv3-field-note">Giá chỉ mang tính tham khảo. Gửi thêm hình mẫu hoặc file thiết kế để IST tư vấn chính xác hơn.</p>
      </div>
      <div id="quote-result" class="tv3-result" aria-labelledby="result-heading">
        <p class="hv3-eyebrow">05 / GIÁ TẠM TÍNH</p><h3 id="result-heading">Giá tem nhãn tham khảo</h3>
        <p id="quote-warning" class="text-gray-500" aria-live="polite">Nhập thông tin bên trái, giá sẽ tự động cập nhật tại đây.</p>
        <dl class="tv3-prices"><div><dt>Đơn giá 1 tem</dt><dd id="quote-unit" class="quote-unit-text">-</dd></div><div><dt>Tổng tiền</dt><dd id="quote-total" class="quote-total-text">-</dd></div></dl>
        <p class="tv3-price-note">Giá thực tế có thể thay đổi theo file thiết kế, kiểu bế, chất liệu, cán màng và tiến độ cần giao.</p>
        <a class="hv3-text-link" href="#contact" data-track-event="service_cta_click" data-track-location="tem_nhan_calculator" data-track-service="tem_nhan" data-track-action="quote_request">Cần IST tư vấn thêm? <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div id="quote-popup" class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/75 p-4" role="dialog" aria-modal="true" aria-label="Báo giá tem nhãn IST" aria-hidden="true">
      <div id="popup-overlay" class="absolute inset-0"></div>
      <div id="quote-popup-card" class="relative z-10 max-h-[94vh] w-full max-w-5xl overflow-y-auto rounded-[20px] bg-zinc-100 text-slate-800 shadow-2xl md:rounded-[24px]">
        <div class="popup-header border-b border-slate-300 bg-white px-4 py-4 md:px-6">
          <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between md:gap-6">
            <div class="flex items-start gap-3 md:gap-4">
              <img src="/images/logo-ist.png" width="1206" height="1328" alt="Logo IST" crossorigin="anonymous" class="h-12 w-auto shrink-0 object-contain md:h-14" />
              <div class="min-w-0">
                <h3 class="popup-title text-lg leading-tight font-black text-slate-900 md:text-2xl">BÁO GIÁ TEM NHÃN IST</h3>
                <p class="mt-1 text-xs text-slate-500 md:text-sm">Công ty TNHH MTV Quảng Cáo In Sáng Tạo</p>
                <p class="mt-1 text-xs text-slate-500">Thiết kế - In ấn - Quảng cáo</p>
              </div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-left md:shrink-0 md:text-right">
              <p id="popup-quote-code" class="popup-code text-base font-black text-slate-900 md:text-xl">IST-TEM-000</p>
              <p id="popup-date" class="mt-1 text-sm text-slate-500">-</p>
              <p class="mt-1 text-xs text-slate-500">Giá trị tham khảo</p>
            </div>
          </div>
        </div>

        <div class="popup-body grid grid-cols-1 gap-5 px-4 py-4 md:px-6 md:py-5 lg:grid-cols-[340px_1fr]">
          <div>
            <div class="mb-4 overflow-hidden rounded-2xl border border-slate-300 bg-white">
              <div class="border-b border-slate-200 px-4 py-3"><p class="text-sm font-black tracking-wide text-slate-800 uppercase">Thông tin đơn hàng</p></div>
              <div class="divide-y divide-slate-200 text-sm">
                <div class="flex items-center justify-between gap-4 px-4 py-3"><span class="text-slate-500">Kích thước</span><strong id="popup-order-size" class="text-right text-slate-900">-</strong></div>
                <div class="flex items-center justify-between gap-4 px-4 py-3"><span class="text-slate-500">Vật liệu</span><strong id="popup-order-material" class="text-right text-slate-900">-</strong></div>
                <div class="flex items-center justify-between gap-4 px-4 py-3"><span class="text-slate-500">Cán màng</span><strong id="popup-order-lamination" class="text-right text-slate-900">-</strong></div>
                <div class="flex items-center justify-between gap-4 px-4 py-3"><span class="text-slate-500">Số lượng</span><strong id="popup-order-quantity" class="text-right text-slate-900">-</strong></div>
              </div>
            </div>
            <div class="overflow-hidden rounded-2xl border border-orange-300 bg-orange-50">
              <div class="flex items-center justify-between gap-4 border-b border-orange-200 px-4 py-3"><span class="font-bold text-orange-700">Giá / 1 tem</span><strong id="popup-unit-price" class="text-xl font-black text-orange-600 md:text-2xl">-</strong></div>
              <div class="flex items-center justify-between gap-4 px-4 py-3"><span class="font-bold text-orange-700">Tổng tiền</span><strong id="popup-total-price" class="text-2xl font-black text-orange-600 md:text-3xl">-</strong></div>
            </div>
            <div class="mt-4 rounded-2xl border border-slate-300 bg-white px-4 py-3"><p class="text-xs leading-relaxed text-slate-500">Giá chỉ mang tính tham khảo. Giá thực tế có thể thay đổi theo file thiết kế, kiểu bế, chất liệu, cán màng và tiến độ cần giao.</p></div>
          </div>
          <div class="overflow-hidden rounded-2xl border border-slate-300 bg-white">
            <div class="border-b border-slate-200 px-4 py-3"><p class="text-sm font-black tracking-wide text-slate-800 uppercase">Giá tham khảo theo số lượng in</p></div>
            <div class="px-3 py-3 md:px-4">
              <div class="mb-2 grid grid-cols-[1.05fr_0.8fr_1.15fr] rounded-xl bg-slate-900 px-3 py-2 text-[11px] font-bold text-white md:grid-cols-3 md:px-4 md:text-xs"><div>SL</div><div class="text-center">Giá</div><div class="text-right">Tổng</div></div>
              <div id="reference-table-body" class="space-y-1.5"></div>
            </div>
          </div>
        </div>

        <div class="quote-contact-footer border-t border-slate-300 bg-white px-6 py-4">
          <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-slate-600"><p><strong class="text-slate-900">In Sáng Tạo</strong> - Thiết kế, in ấn, tem nhãn, bảng hiệu quảng cáo</p><p class="font-bold text-orange-600">Zalo / Hotline: 0974 31 32 30</p></div>
        </div>
        <div class="popup-footer flex flex-col gap-3 rounded-b-[20px] border-t border-slate-300 bg-white px-4 py-3 md:flex-row md:items-center md:justify-end md:rounded-b-[24px] md:px-6">
          <button id="copy-image-btn" type="button" class="w-full rounded-xl bg-emerald-600 px-4 py-2.5 font-bold text-white transition hover:bg-emerald-700 md:w-auto">Copy ảnh</button>
          <button id="save-image-btn" type="button" class="w-full rounded-xl bg-orange-500 px-4 py-2.5 font-bold text-white transition hover:bg-orange-600 md:w-auto">Lưu ảnh</button>
          <button id="close-popup-bottom" type="button" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 font-bold text-slate-700 transition hover:bg-slate-100 md:w-auto">Đóng</button>
        </div>
      </div>
    </div>
  </div>
</section>

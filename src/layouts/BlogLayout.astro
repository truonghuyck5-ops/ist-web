---
import BaseLayout from './BaseLayout.astro'
import { formatBlogDate } from '../utils/blog'
import ContactCta from '../components/sections/home/ContactCta.astro'

const { post } = Astro.props
const { data } = post
const canonical = data.canonical ?? `/blog/${post.id}/`
const title = `${data.title} | IST`
---

<BaseLayout title={title} description={data.description} canonical={canonical} ogImage={data.image}>
  <main class="bg-black py-16 text-white md:py-24">
    <article class="mx-auto max-w-3xl px-6">
      <a href="/blog/" class="mb-10 inline-flex font-bold text-orange-500 transition hover:text-orange-300">← Quay lại Blog</a>
      <header class="mb-12">
        {data.category && <p class="mb-4 font-semibold tracking-[0.18em] text-orange-500 uppercase">{data.category}</p>}
        <h1 class="mb-6 text-4xl leading-tight font-black md:text-6xl">{data.title}</h1>
        <p class="text-lg leading-relaxed text-gray-300 md:text-xl">{data.description}</p>
        <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm text-gray-500">
          <time datetime={data.publishedAt.toISOString()}>Đăng ngày {formatBlogDate(data.publishedAt)}</time>
          {data.updatedAt && <time datetime={data.updatedAt.toISOString()}>Cập nhật {formatBlogDate(data.updatedAt)}</time>}
          {data.author && <span>{data.author}</span>}
        </div>
      </header>

      {data.image && <img src={data.image} alt={data.title} class="mb-12 w-full rounded-3xl border border-zinc-800" />}

      <div class="blog-content text-lg leading-relaxed text-gray-300 [&_a]:font-semibold [&_a]:text-orange-500 [&_a]:underline [&_h2]:mt-12 [&_h2]:mb-5 [&_h2]:text-3xl [&_h2]:font-black [&_h2]:text-white [&_h3]:mt-10 [&_h3]:mb-4 [&_h3]:text-2xl [&_h3]:font-bold [&_h3]:text-white [&_li]:mb-2 [&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mb-6 [&_ul]:mb-6 [&_ul]:list-disc [&_ul]:pl-6">
        <slot />
      </div>

      {data.tags.length > 0 && <footer class="mt-14 border-t border-zinc-800 pt-8"><p class="mb-3 text-sm font-semibold text-gray-400">Chủ đề</p><div class="flex flex-wrap gap-2">{data.tags.map((tag) => <span class="rounded-full border border-zinc-700 px-3 py-1 text-sm text-gray-300">{tag}</span>)}</div></footer>}
    </article>
  </main>
  <ContactCta />
</BaseLayout>

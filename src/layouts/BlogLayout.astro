---
import ProductLayout from './ProductLayout.astro'
import Media from '../components/home-v3/Media.astro'
import ContactCta from '../components/home-v3/ContactCta.astro'
import { productGroups } from '../components/home-v3/content.js'
import { formatBlogDate } from '../utils/blog'
import { blogPostingStructuredData } from '../utils/seo'
import '../styles/blog-v3.css'
const { post } = Astro.props
const { data } = post
const canonical = data.canonical ?? `/blog/${post.id}/`
const title = `${data.title} | IST`
const service = productGroups.find(item => item.service === data.relatedService)
const signage = service?.service === 'bang_hieu'
---
<ProductLayout pageClass="bv3 bv3-article" seo={{ title, description: data.description, canonical, image: data.image, type: 'article', structuredData: blogPostingStructuredData({ title, description: data.description, image: data.image, canonical }) }}>
  <article class="bv3-reading">
    <header class="bv3-article-header" data-v3-contact-area>
      {data.category && <p class="hv3-eyebrow"><span class="hv3-marker" aria-hidden="true"></span>{data.category}</p>}
      <h1>{data.title}</h1><p class="bv3-description">{data.description}</p>
      {(data.publishedAt || data.updatedAt || data.author) && <div class="bv3-meta">
        {data.publishedAt && <time datetime={data.publishedAt.toISOString()}>Đăng ngày {formatBlogDate(data.publishedAt)}</time>}
        {data.updatedAt && <time datetime={data.updatedAt.toISOString()}>Cập nhật {formatBlogDate(data.updatedAt)}</time>}
        {data.author && <span>{data.author}</span>}
      </div>}
    </header>
    {data.image && <figure class="hv3-media-frame bv3-article-media" style={`--bv3-image-ratio: ${data.imageWidth} / ${data.imageHeight}`}><Media src={data.image} alt={data.imageAlt || data.title} width={data.imageWidth} height={data.imageHeight} eager={true} /></figure>}
    <div class="bv3-prose"><slot /></div>
  </article>
  {service && <section class="bv3-related hv3-container" aria-labelledby="related-heading">
    <div><p class="hv3-eyebrow"><span class="hv3-marker" aria-hidden="true"></span>DỊCH VỤ LIÊN QUAN</p><h2 id="related-heading">{signage ? 'BẢNG HIỆU QUẢNG CÁO' : 'IN TEM NHÃN'}</h2></div>
    <div><p class="hv3-body">{signage ? 'Trao đổi hạng mục và nhu cầu để IST tư vấn phương án phù hợp.' : 'Chọn kích thước, chất liệu và số lượng phù hợp cho mẫu tem của bạn.'}</p><div class="bv3-related-actions">
      <a class="hv3-text-link" href={service.href} data-track-event="service_cta_click" data-track-location="blog_related" data-track-service={service.service} data-track-action="view_service">Xem dịch vụ <span aria-hidden="true">↗</span></a>
      {signage ? <a class="hv3-text-link" href="/du-an/" data-track-event="service_cta_click" data-track-location="blog_related" data-track-service={service.service} data-track-action="view_projects">Xem công trình thực tế <span aria-hidden="true">↗</span></a> : <a class="hv3-text-link" href="/tem-nhan/#calculator" data-track-event="service_cta_click" data-track-location="blog_related" data-track-service={service.service} data-track-action="view_calculator">Tính giá tem nhãn <span aria-hidden="true">↗</span></a>}
    </div></div>
  </section>}
  <div class="hv3-container bv3-back"><a class="hv3-text-link" href="/blog/"><span aria-hidden="true">←</span> Quay lại Kiến thức</a></div>
  <ContactCta headingLineOne="CẦN IST" headingLineTwo="TƯ VẤN?" />
</ProductLayout>

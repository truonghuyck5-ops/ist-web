---
import { getCollection } from 'astro:content'
import ProductLayout from '../../layouts/ProductLayout.astro'
import BlogCard from '../../components/blog/BlogCard.astro'
import ContactCta from '../../components/home-v3/ContactCta.astro'
import '../../styles/blog-v3.css'
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((left, right) => {
  if (!left.data.publishedAt || !right.data.publishedAt) return left.id.localeCompare(right.id)
  return right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf()
})
---
<ProductLayout pageClass="bv3 bv3-hub" seo={{ title: 'Blog kiến thức thiết kế, in ấn & quảng cáo | IST', description: 'Kinh nghiệm thực tế về bảng hiệu, tem nhãn, thiết kế và quảng cáo từ In Sáng Tạo IST.', canonical: '/blog/' }}>
  <section class="pv3-hero hv3-container" data-v3-contact-area aria-labelledby="hero-heading">
    <div class="pv3-hero-copy"><p class="hv3-eyebrow"><span class="hv3-marker" aria-hidden="true"></span>IST / KIẾN THỨC</p><h1 id="hero-heading">KIẾN THỨC</h1></div>
    <div class="pv3-hero-intro"><p class="pv3-introduction hv3-body">Kinh nghiệm thực tế về thiết kế, in ấn và quảng cáo.</p></div>
  </section>
  <section class="bv3-list hv3-container" aria-label="Bài viết kiến thức">{posts.map((post, index) => <BlogCard post={post} eager={index === 0} />)}</section>
  <ContactCta headingLineOne="CẦN IST" headingLineTwo="TƯ VẤN?" />
</ProductLayout>

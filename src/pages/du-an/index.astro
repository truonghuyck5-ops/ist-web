---
import ProductLayout from '../../layouts/ProductLayout.astro'
import ProductHero from '../../components/product-v3/ProductHero.astro'
import ContactCta from '../../components/home-v3/ContactCta.astro'
import ProjectFeature from '../../components/projects/ProjectFeature.astro'
import { featuredProjects } from '../../data/featuredProjects.js'
import '../../styles/projects-v3.css'

const listingProjects = featuredProjects.filter((project) => project.listingVisible)
---
<ProductLayout pageClass="rv3" seo={{
  title: 'Công trình đã thực hiện | In Sáng Tạo',
  description: 'Hình ảnh và phần việc IST thực hiện trong các hạng mục bảng hiệu cho cửa hàng và doanh nghiệp. Xem công trình và liên hệ tư vấn hạng mục tương tự.',
  canonical: '/du-an/',
}}>
  <ProductHero eyebrow="CÔNG TRÌNH / THỰC TẾ" lines={['CÔNG TRÌNH', 'THỰC TẾ']} description="Một số hình ảnh và phần việc trong các hạng mục IST đã triển khai." location="projects_hero" primary={{ label: 'Xem công trình', href: '#projects-list', action: 'view_projects' }} secondary={{ label: 'Nhận tư vấn', href: '#contact', action: 'quote_request' }} />
  <section id="projects-list" class="rv3-list hv3-container" aria-label="Công trình IST đã thực hiện">
    {listingProjects.map((project, index) => <ProjectFeature project={project} index={index} />)}
  </section>
  <section class="rv3-related hv3-container" aria-labelledby="related-heading">
    <div><p class="hv3-eyebrow"><span class="hv3-marker" aria-hidden="true"></span>DỊCH VỤ LIÊN QUAN</p><h2 id="related-heading">BẢNG HIỆU QUẢNG CÁO</h2></div>
    <div><p class="hv3-body">Các công trình hiện tại là những ví dụ về hạng mục bảng hiệu IST đã thực hiện.</p><a class="hv3-text-link" href="/bang-hieu/" data-track-event="service_cta_click" data-track-location="projects_related" data-track-service="bang_hieu" data-track-action="view_service">Xem dịch vụ bảng hiệu <span aria-hidden="true">↗</span></a></div>
  </section>
  <ContactCta headingLineOne="CẦN HẠNG MỤC" headingLineTwo="TƯƠNG TỰ?" />
  <script>
    import '../../scripts/project-lightbox.client.js'
  </script>
</ProductLayout>

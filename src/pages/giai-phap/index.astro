---
import SolutionLayout from '../../layouts/SolutionLayout.astro'
import Media from '../../components/home-v3/Media.astro'
import ContactCta from '../../components/home-v3/ContactCta.astro'
import { solutionStorefront, solutionConsultationNeeds } from '../../data/solutions.js'
---
<SolutionLayout pageClass="sv3-hub" seo={{ title: 'Giải pháp cho nhu cầu kinh doanh | IST', description: 'Chọn nhu cầu mở quán, làm mới cửa hàng hoặc chuẩn bị khai trương. IST kết nối bảng hiệu, ấn phẩm và các hạng mục phù hợp để tư vấn theo nhu cầu của bạn.', canonical: '/giai-phap/', image: solutionStorefront.src }}>
  <section class="hv3-container sv3-hub-hero" data-v3-contact-area aria-labelledby="hero-heading"><div><p class="hv3-eyebrow"><span class="hv3-marker" aria-hidden="true"></span>GIẢI PHÁP / THEO NHU CẦU</p><h1 id="hero-heading">GIẢI PHÁP</h1></div><div><p class="hv3-body">Chọn nhu cầu của bạn.<br />IST sẽ kết nối các sản phẩm và hạng mục phù hợp.</p><a class="hv3-text-link" href="#needs" data-track-event="service_cta_click" data-track-location="solution_hub_hero" data-track-action="view_products">Xem nhu cầu <span aria-hidden="true">↓</span></a></div></section>
  <section id="needs" class="hv3-section sv3-needs" aria-labelledby="opening-heading"><div class="hv3-container sv3-opening"><div><p class="hv3-eyebrow">01 / MỞ QUÁN</p><h2 id="opening-heading">TÔI CHUẨN BỊ<br />MỞ QUÁN.</h2><p class="hv3-body">Chuẩn bị nhận diện cho cửa hàng, quán ăn, café hoặc điểm kinh doanh mới.</p><p class="hv3-body">Từ bảng hiệu, menu và tem nhãn đến decal, voucher và ấn phẩm khai trương — chọn theo mô hình và nhu cầu của bạn.</p><a class="hv3-button hv3-button-ink" href="/combo-mo-quan/" data-track-event="service_cta_click" data-track-location="solution_hub_need" data-track-service="combo_mo_quan" data-track-action="view_service">Xem Combo mở quán <span aria-hidden="true">↗</span></a></div><figure><div class="hv3-media-frame sv3-storefront"><Media {...solutionStorefront} eager={true} /></div><figcaption>THAM KHẢO HẠNG MỤC BẢNG HIỆU TẠI IST</figcaption></figure></div></section>
  <section id="consultation-needs" class="hv3-section hv3-soft" aria-labelledby="consultation-heading"><div class="hv3-container"><div class="hv3-section-head"><div><p class="hv3-eyebrow">TRAO ĐỔI NHU CẦU KHÁC</p><h2 id="consultation-heading">BẠN ĐANG<br />CHUẨN BỊ ĐIỀU GÌ?</h2></div><p class="hv3-body pv3-section-note">Bắt đầu từ mục tiêu.<br />IST tư vấn hạng mục phù hợp.</p></div><ol class="sv3-consultation-list">{solutionConsultationNeeds.map((item, index) => <li><span aria-hidden="true">{String(index + 2).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><a class="hv3-text-link" href={item.href} data-track-event="service_cta_click" data-track-location="solution_hub_consultation" data-track-action={item.action}>Trao đổi nhu cầu <span aria-hidden="true">↗</span></a></li>)}</ol></div></section>
  <ContactCta headingLineOne="BẠN CẦN" headingLineTwo="CHUẨN BỊ GÌ?" description={['Chia sẻ mô hình và nhu cầu của bạn với IST.', 'IST sẽ tư vấn hạng mục và phương án phù hợp.']} />
</SolutionLayout>

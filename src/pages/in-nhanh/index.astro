---
import ProductLayout from '../../layouts/ProductLayout.astro'
import ProductHero from '../../components/product-v3/ProductHero.astro'
import ProductIndex from '../../components/product-v3/ProductIndex.astro'
import Media from '../../components/home-v3/Media.astro'
import ContactCta from '../../components/home-v3/ContactCta.astro'
import { inNhanhHero, inNhanhGroups, inNhanhGallery, inNhanhProduction, inNhanhRelated, inNhanhCopy } from '../../data/inNhanh.js'
import '../../styles/in-nhanh-v3.css'
---
<ProductLayout pageClass="qv3" seo={{ title: 'In nhanh — Danh thiếp, Tag & Ấn phẩm giấy | IST', description: 'Danh thiếp, tag, voucher, tờ rơi và menu giấy in kỹ thuật số tại IST. Xem mẫu in thực tế và trao đổi nhu cầu để được tư vấn, báo giá phù hợp.', canonical: '/in-nhanh/', image: inNhanhHero.src }}>
  <ProductHero eyebrow="SẢN PHẨM / IN NHANH" lines={['IN NHANH']} description={inNhanhCopy.introduction} location="in_nhanh_hero" service="in_nhanh" caption="MẪU DANH THIẾP GIẤY TẠI IST" media={inNhanhHero} primary={{ href: '#contact', label: 'Nhận tư vấn / Báo giá', action: 'quote_request' }} secondary={{ href: '#products', label: 'Xem sản phẩm', action: 'view_products' }} />
  <section id="products" class="hv3-section qv3-products" aria-labelledby="types-heading"><div class="hv3-container"><div class="hv3-section-head"><div><p class="hv3-eyebrow">01 / ẤN PHẨM GIẤY</p><h2 id="types-heading">CHỌN ẤN PHẨM<br />CHO NHU CẦU CỦA BẠN.</h2></div><p class="hv3-body pv3-section-note">Năm nhóm sản phẩm giấy<br />phục vụ kinh doanh tại IST.</p></div><ProductIndex items={inNhanhGroups} headingLevel="h3" location="in_nhanh_products" /></div></section>
  <section id="samples" class="hv3-section hv3-soft" aria-labelledby="samples-heading"><div class="hv3-container"><div class="hv3-section-head"><div><p class="hv3-eyebrow">02 / THÀNH PHẨM TẠI IST</p><h2 id="samples-heading">MẪU IN<br />THỰC TẾ.</h2></div><p class="hv3-body pv3-section-note">Hình ảnh ấn phẩm giấy<br />được thực hiện tại IST.</p></div><div class="qv3-gallery">{[inNhanhGallery.filter((_, index) => index % 2 === 0), inNhanhGallery.filter((_, index) => index % 2 === 1)].map(column => <div class="qv3-gallery-column">{column.map(({ title, ...media }) => <figure><div class="hv3-media-frame qv3-sample-frame" style={`--qv3-photo-ratio: ${media.width} / ${media.height}`}><Media {...media} /></div><figcaption><h3>{title}</h3></figcaption></figure>)}</div>)}</div></div></section>
  <section id="production" class="hv3-section" aria-labelledby="production-heading"><div class="hv3-container qv3-production"><div><p class="hv3-eyebrow">03 / SẢN XUẤT TẠI IST</p><h2 id="production-heading">IN KỸ THUẬT SỐ<br />TẠI IST.</h2><p class="hv3-body">Ấn phẩm giấy được in kỹ thuật số tại IST với máy in Konica C2060L.</p><p class="hv3-body">Trao đổi nội dung và cách sử dụng để IST tư vấn phương án in phù hợp.</p><a class="hv3-text-link" href="#contact" data-track-event="service_cta_click" data-track-location="in_nhanh_production" data-track-service="in_nhanh" data-track-action="quote_request">Trao đổi nhu cầu in <span aria-hidden="true">↗</span></a></div><figure><div class="hv3-media-frame qv3-production-frame"><Media {...inNhanhProduction} /></div><figcaption>MÁY IN KỸ THUẬT SỐ TẠI XƯỞNG IST</figcaption></figure></div></section>
  <section id="uses" class="hv3-section hv3-soft" aria-labelledby="uses-heading"><div class="hv3-container pv3-split"><div><p class="hv3-eyebrow">04 / THEO NHU CẦU</p><h2 id="uses-heading">ẤN PHẨM GIẤY<br />DÙNG CHO VIỆC GÌ?</h2></div><ol class="qv3-uses">{inNhanhCopy.uses.map(([title, description], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{description}</p></div></li>)}</ol></div></section>
  <section id="related" class="hv3-section" aria-labelledby="related-heading"><div class="hv3-container"><div class="hv3-section-head"><div><p class="hv3-eyebrow">05 / SẢN PHẨM LIÊN QUAN</p><h2 id="related-heading">TÌM ĐÚNG<br />NHÓM SẢN PHẨM.</h2></div><p class="hv3-body pv3-section-note">Nếu nhu cầu thuộc nhóm khác,<br />xem giải pháp phù hợp tại IST.</p></div><ProductIndex items={inNhanhRelated} headingLevel="h3" location="in_nhanh_related" /></div></section>
  <section id="process" class="hv3-section hv3-soft" aria-labelledby="process-heading"><div class="hv3-container"><div class="hv3-section-head"><div><p class="hv3-eyebrow">06 / CÁCH IST LÀM</p><h2 id="process-heading">TỪ NHU CẦU<br />ĐẾN BẢN IN.</h2></div></div><ol class="pv3-process">{inNhanhCopy.steps.map(([title, description], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{description}</p></li>)}</ol></div></section>
  <ContactCta headingLineOne="CẦN IN" headingLineTwo="ẤN PHẨM?" description={['Gửi file hoặc nhu cầu của bạn cho IST.', 'IST sẽ tư vấn phương án và báo giá phù hợp.']} />
</ProductLayout>

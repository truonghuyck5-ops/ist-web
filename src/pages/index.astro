---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/home-v3.css'
import Navbar from '../components/home-v3/Navbar.astro'
import Hero from '../components/home-v3/Hero.astro'
import QuickPortal from '../components/home-v3/QuickPortal.astro'
import ProductExplorer from '../components/home-v3/ProductExplorer.astro'
import SelectedProjects from '../components/home-v3/SelectedProjects.astro'
import ProductionProof from '../components/home-v3/ProductionProof.astro'
import Process from '../components/home-v3/Process.astro'
import ContactCta from '../components/home-v3/ContactCta.astro'
import Footer from '../components/home-v3/Footer.astro'
import FloatingContact from '../components/home-v3/FloatingContact.astro'
import { organizationStructuredData } from '../utils/seo'
---

<BaseLayout bodyClass="hv3" bodyId="top" viewportFit="cover" seo={{
  title: 'IST - Công ty TNHH MTV Quảng Cáo In Sáng Tạo - Thiết kế, In ấn & Quảng cáo tại Vĩnh Long',
  description: 'Công ty TNHH MTV Quảng Cáo In Sáng Tạo - IST chuyên thiết kế, in ấn, tem nhãn, bảng hiệu quảng cáo, in khổ lớn, thi công công trình cho shop, doanh nghiệp và cơ quan tại Trà Vinh, Vĩnh Long.',
  canonical: '/',
  structuredData: organizationStructuredData,
}}>
  <Navbar slot="navbar" />
  <a slot="before-main" class="hv3-skip-link" href="#main">Đến nội dung chính</a>
  <main id="main"><Hero /><QuickPortal /><ProductExplorer /><SelectedProjects /><ProductionProof /><Process /><ContactCta /></main>
  <Footer slot="footer" />
  <FloatingContact slot="floating-contact" />
</BaseLayout>
